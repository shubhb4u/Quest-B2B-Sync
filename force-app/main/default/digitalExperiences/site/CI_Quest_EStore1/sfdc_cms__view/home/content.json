                "paddingHorizontal" : "none",
                "paddingVertical" : "none",
                "text" : "Why Quest?",
                "textAlign" : "center",
                "textDecoration" : "{}",
                "textDisplayInfo" : "{\"textStyle\":\"heading-xlarge\",\"headingTag\":\"h1\"}"
              },
              "customCssClasses" : "why-quest",
